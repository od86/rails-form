<h1>Add user</h1>
<%= form_with url: "/users" do |form| %>
  <div>
    <%= form.label :username, "Name:" %>
    <%= form.text_field :username %>
  </div>

  <div>
    <%= form.label :email, "Email:" %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :password, "Password:" %>
    <%= form.password_field :password %>
  </div>
  <%= form.submit "Submit:" %>
<% end %>